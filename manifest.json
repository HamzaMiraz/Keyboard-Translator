{
  "manifest_version": 3,
  "name": "Keyboard Translator",
  "version": "1.0",
  "description": "Translates text as you type and translates selected sentences to English.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "api.js",
        "engine.js",
        "ui.js",
        "selection.js",
        "main.js"
      ]
    }
  ]
}